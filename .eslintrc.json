{
  "extends": [
    "@tpluscode",
    "plugin:storybook/recommended"
  ],
  "parserOptions": {
    "project": "./tsconfig.lint.json"
  },
  "rules": {
    "@typescript-eslint/no-useless-constructor": "off",
    "@typescript-eslint/no-explicit-any": "warn"
  },
  "overrides": [{
    "files": ["stories/**/*.ts"],
    "rules": {
      "import/no-extraneous-dependencies": "warn"
    }
  }]
}
