{
  "name": "lit-rdf",
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "prepare": "husky && patch-package",
    "lint": "eslint . --quiet",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest --project=storybook",
    "test:unit": "vitest --project=unit",
    "test:wtr": "wtr",
    "analyze": "cem analyze",
    "prebuild": "npm run analyze",
    "build": "tsc",
    "prepack": "npm run build",
    "release": "changeset publish"
  },
  "files": [
    "CHANGELOG.md",
    "custom-elements.json",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hypermedia-app/lit-rdf"
  },
  "exports": {
    ".": "./src/index.js",
    "./components/*.js": "./src/components/*.js",
    "./converter.js": "./src/converter.js",
    "./constructor.js": "./src/constructor.js",
    "./mixins.js": "./src/mixins.js",
    "./controllers.js": "./src/controllers.js",
    "./sort.js": "./src/sort.js"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@rdfjs-elements/lit-helpers": "^0.3.13",
    "@rdfjs/data-model": "^2.1.1",
    "@rdfjs/dataset": "^2.0.3",
    "@rdfjs/types": "^2",
    "@zazuko/env": "^3.0.1",
    "@zazuko/prefixes": "^2.6.1",
    "clownface": "^2.0.3",
    "clownface-shacl-path": "^2.4.0",
    "is-url": "^1.2.4",
    "lit": "^3",
    "rdf-canonize": "^3.4.0",
    "rdf-literal": "^2.0.0",
    "sparql-path-parser": "^0.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0-next.11",
    "@chromatic-com/storybook": "^5.3.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10",
    "@lit-labs/ssr": "^4.1.0",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-commonjs": "^26",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@tpluscode/eslint-config": "^4.0.2",
    "@types/clownface": "^2.0.10",
    "@types/is-url": "^1.2.32",
    "@types/rdfjs__data-model": "^2.0.9",
    "@types/rdfjs__dataset": "^2.0.7",
    "@types/readable-stream": "^4.0.24",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vocabulary/rdfs": "^1.0.6",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/dev-server-rollup": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "cem-plugin-dts": "^1.1.0",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-storybook": "^10.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.58.2",
    "sinon": "^22.1.0",
    "storybook": "^10.6.0",
    "string-to-stream": "^3.0.1",
    "typescript": "^5",
    "util": "^0.12.5",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --quiet"
    ]
  },
  "customElements": "custom-elements.json",
  "engines": {
    "node": ">=21"
  }
}
