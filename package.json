{
  "name": "lit-rdf",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --quiet --ignore-path .gitignore --ignore-path .eslintignore",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --project=storybook",
    "build": "tsc",
    "prepack": "npm run build",
    "release": "changeset publish"
  },
  "files": [
    "CHANGELOG.md",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hypermedia-app/lit-rdf"
  },
  "exports": {
    ".": "./src/index.js",
    "./components/*.js": "./src/components/*.js",
    "./converter.js": "./src/converter.js",
    "./constructor.js": "./src/constructor.js",
    "./mixins.js": "./src/mixins.js",
    "./controllers.js": "./src/controllers.js",
    "./runtime/*.js": "./src/runtime/*.js"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@rdfjs-elements/lit-helpers": "^0.3.13",
    "@rdfjs/data-model": "^2.1.1",
    "@rdfjs/types": "^2",
    "@zazuko/env": "^3.0.1",
    "@zazuko/prefixes": "^2.6.1",
    "clownface": "^2.0.3",
    "clownface-shacl-path": "^2.4.0",
    "is-url": "^1.2.4",
    "lit": "^3",
    "sparql-path-parser": "^0.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@chromatic-com/storybook": "^5.3.0",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/web-components-vite": "^10.5.7",
    "@tpluscode/eslint-config": "^0.6.4",
    "@types/clownface": "^2.0.10",
    "@types/is-url": "^1.2.32",
    "@types/rdfjs__data-model": "^2.0.9",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vocabulary/rdfs": "^1.0.6",
    "eslint-import-resolver-typescript": "^2",
    "eslint-plugin-storybook": "^10.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "storybook": "^10.5.7",
    "string-to-stream": "^3.0.1",
    "typescript": "^5",
    "util": "^0.12.5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --quiet"
    ]
  }
}
