{
  "compilerOptions": {
    "target": "ES2024",
    "module": "es2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "declaration": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
