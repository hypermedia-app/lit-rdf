{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "declaration": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    ".storybook",
    "stories",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
